# Archivos temporales generados por Python
__pycache__/
*.py[cod]

# Entornos virtuales
.venv/
venv/
env/

# Variables de entorno y configuración privada
.env
.env.*
!.env.example

# Base de datos local SQLite
db.sqlite3
db.sqlite3-journal

# Registros de ejecución
*.log

# Archivos recopilados por collectstatic
/staticfiles/

# Archivos cargados por los usuarios durante pruebas locales
/media/

# Configuración local de editores
.vscode/
.idea/

# Archivos del sistema operativo
.DS_Store
Thumbs.db